# -*- mode: editorconfig-conf -*-
# https://EditorConfig.org

# top-most EditorConfig file; stop searching for other files
root = true

# Defaults for every file
[*]
# Unix-style newlines
end_of_line = lf
# newline ending every file
insert_final_newline = true
trim_trailing_whitespace = true

# Indents
indent_style = space
indent_size = 4

[*.yaml]
indent_style = space
indent_size = 2

