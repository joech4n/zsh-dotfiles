[alias]
    ci = commit
    co = checkout
    count = !git shortlog -sn
    dag
    promote = !$ZSH/bin/git-promote
    rank-contributors = !$ZSH/bin/git-rank-contributors
    st = status
    wtf = !$ZSH/bin/git-wtf
[apply]
    whitespace = nowarn
[color]
    branch = auto
    diff = auto
    status = auto
    ui = true
[core]
    editor = vim
    excludesfile = ~/.gitignore
    hooksPath = ~/.git_hooks
[credential]
    helper = osxkeychain
[difftool]
    prompt = false
[help]
    autocorrect = 1
[hub]
    protocol = https
[mergetool]
    keepBackup = false
[pull]
    ff = only
[push]
    # See `git help config` (search for push.default)
    # for more information on different options of the below setting.
    # Setting to git 2.0 default to surpress warning message
    default = simple
[rerere]
    # Reuse recorded resolution of conflicted merges
    enabled = true
[user]
    email = joech4n@users.noreply.github.com
    name = Joe Chan

# diff-so-fancy
# Colors from https://github.com/so-fancy/diff-so-fancy/blob/4de6d16caeb0a60a16987778eae57b25ef8adef4/README.md?plain=1#L32
[color "diff-highlight"]
        oldNormal = red bold
        oldHighlight = red bold 52
        newNormal = green bold
        newHighlight = green bold 22
[color "diff"]
        meta = 11
        frag = magenta bold
        func = 146 bold
        commit = yellow bold
        old = red bold
        new = green bold
        whitespace = red reverse
[color]
        ui = true
[pager]
    # You can pre-seed your less pager with a search pattern, so you can move between files with n/N keys:
    dsf = diff-so-fancy | less --tabs=4 -RFXS --pattern '^(Date|added|deleted|modified): '
[alias]
        dsf = diff --color

[include]
    # Include a per-machine .gitconfig
    path = ~/.gitconfig.local
