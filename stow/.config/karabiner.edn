        {:des   "right_control to ! when pressed alone"
         :rules [[:##right_control :right_control nil {:alone :!S1}]]}

        {:des   "left_control to @ when pressed alone"
         :rules [[:##left_control :left_control nil {:alone :!S2}]]}

        {:des "One Mode: Colemak Numpad (Right Hand)"
         :rules [:one-mode
            [:spacebar :0]
            [:m :1]
            [:comma :2]
            [:period :3]
            [:j :4]
            [:k :5]
            [:l :6]
            [:u :7]
            [:i :8]
            [:o :9]
            [:p :hyphen]
            [:semicolon :!Sequal_sign]
            [:right_shift :return_or_enter]
