                  {:alone ["o-sub-layer-mode" 1]
                    ; when another key is invoked, or after a timeout, set the mode back to zero
                   :delayed {:invoked [:##semicolon ["o-sub-layer-mode" 0]] :canceled ["o-sub-layer-mode" 0]}}]]}

