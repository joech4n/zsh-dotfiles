                ;;            ;;
                ;;            ; ! is best but downsides of ! in next line are:
                ;;            ; - To output modifier+key, you need to hold the modifier until the timeout completes.
                ;;            ; - If you activate the mode but don't complete the sequence within 500ms (:invoked), then key without modifier will be output.
                ;;            ;; TODO: Need to find a key that will never be used for anything else.
                ;;            [:!Csemicolon ["o-sub-layer-mode" 1] nil
