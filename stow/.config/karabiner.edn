        {:des "hyper+o (o)pen sublayer keys"
         :rules [;; Map qwerty equivalent in Colemak, i.e. k for e.
                 [:##b "open -a \"$HOME/Applications/Chrome Apps.localized/Google Chat.app\"" [:o-sub-layer-mode]]
