                 ;; Any rule that depends on o-sub-layer-mode being set must come before the delayed declaration.
                 ;;  Enable r-sub-layer-mode
                 [:s ["r-sub-layer-mode" 1] nil
                    ; and if sublayer key is pressed alone, trigger r-sub-layer-mode variable
                  {:alone ["r-sub-layer-mode" 1]
                    ; when another key is invoked, or after a timeout, set the mode back to zero
                   :delayed {:invoked [:##s ["r-sub-layer-mode" 0]] :canceled ["r-sub-layer-mode" 0]}}]
