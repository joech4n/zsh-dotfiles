// Setup instructions:
// mkdir -p $HOME/Library/KeyBindings
// ln -s $HOME/.dotfiles/osx/DefaultKeyBinding.dict $HOME/Library/KeyBindings/DefaultKeyBinding.dict

// Set a binding for repeating action (e.g.: ^u, 5, right arrow)
// > defaults write -g NSRepeatCountBinding -string "^u"

{
// https://brettterpstra.com/2014/08/20/keybindings-that-everyone-should-have/

// TextMate Command-Return (Command Enter)
"@\U000D" = (moveToEndOfParagraph:, insertNewline:);
// Insert blank line above paragraph (Command Shift Enter)
"@$\U000D" = (moveToBeginningOfParagraph:, moveLeft:, insertNewline:);

// select word
"~w" = (selectWord:);
}
